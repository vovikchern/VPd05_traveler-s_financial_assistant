# Скопируйте этот файл в .env и вставьте свои значения
# (пароль и токены хранить только в .env — его НЕ коммитим)

# API-ключ с сайта https://exchangerate.host (кнопка GET FREE KEY)
CURRENCY_API_KEY=your_actual_currency_api_key

# Токен бота, полученный от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_actual_telegram_token
